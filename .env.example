# Build env for a production build. Copy to .env.production (gitignored) and fill in.
# Everything here is public: it ends up in the built JavaScript or HTML.
# For local development use .env.development.example instead.

# Backend (skuilder express) and CouchDB, as the browser reaches them.
# Setting VITE_COUCH_BASE_URL selects the CouchDB data layer. Leave both unset
# (or set VITE_DATA_LAYER=static) to ship the packed static course instead:
# no accounts, progress kept in the browser.
VITE_API_BASE_URL=/express
VITE_COUCH_BASE_URL=example.com/couch/
VITE_COUCHDB_PROTOCOL=https
VITE_APP_NAME=LettersPractice

# The site's origin, no trailing slash. Used for canonical links, link-preview
# tags (index.html, src/services/pageMeta.ts), the sitemap, feeds and
# structured data (scripts/prerender-public.ts). Unset: none of those.
VITE_SITE_URL=https://example.com

# Support address shown on sign-in error screens. Unset: no contact line.
VITE_SUPPORT_EMAIL=

# Media host for the landing page's demo video (its /v/ route), e.g.
# https://media.example.com. Also added to the CSP's media-src. Unset: no video section.
VITE_MEDIA_BASE=

# Google sign-in (OAuth client ID; public). Unset: no Google button.
VITE_GOOGLE_CLIENT_ID=

# robots.txt extras, read by scripts/prerender-public.ts. Optional.
# ROBOTS_SITEMAPS=
# ROBOTS_CONTENT_SIGNAL=
