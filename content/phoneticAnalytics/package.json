{
  "name": "gpc-content-pipeline",
  "version": "2.1.0",
  "description": "GPC extraction pipeline and phonetic analytics library for phonics curriculum",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "build:check": "tsc --noEmit",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.lib.json --noEmit",
    "test": "tsx test/test-alignment.ts",
    "test:cards": "tsx scripts/test-cards.ts",
    "gen:words": "tsx scripts/parse-corpus-with-GPCs.ts",
    "gen:sequence": "tsx scripts/calculate-gpc-sequence.ts | tee outputs-v2/gpc-sequence-$(date +%Y%m%d-%H%M%S).md",
    "gen:priorities": "tsx scripts/generate-recording-priorities.ts",
    "analyze:pairs": "tsx scripts/analyze-minimal-pairs.ts",
    "gen:strategies": "tsx scripts/generate-strategy-configs.ts",
    "gen:cards": "tsx scripts/generate-cards.ts",
    "gen:reachable": "tsx scripts/generate-reachable-words.ts",
    "deploy:content": "tsx scripts/deploy-content.ts",
    "audit:prod": "tsx scripts/audit-prod-content.ts",
    "prune:orphans": "tsx scripts/prune-orphans.ts",
    "audit:blast-radius": "tsx scripts/enumerate-blast-radius.ts",
    "upload:cards": "echo '⚠️  DEPRECATED: use yarn deploy:content' && tsx scripts/deploy-content.ts",
    "db:seed": "tsx scripts/seed-local-db.ts",
    "gen:all": "yarn gen:words && yarn gen:sequence && yarn analyze:pairs && yarn gen:priorities && yarn gen:cards && yarn gen:strategies",
    "dev": "vite ui"
  },
  "exports": {
    ".": "./lib/index.ts"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitejs/plugin-vue": "^6.0.3",
    "tsx": "^4.7.0",
    "typescript": "~6.0.3",
    "vite": "^7.3.1",
    "vue": "^3.5.27"
  }
}
