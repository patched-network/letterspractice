{
  "name": "letterspractice",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist-lib/questions.cjs.js",
  "module": "./dist-lib/questions.mjs",
  "types": "./dist-lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-lib/index.d.ts",
      "import": "./dist-lib/questions.mjs",
      "require": "./dist-lib/questions.cjs.js"
    },
    "./questions": {
      "types": "./dist-lib/index.d.ts",
      "import": "./dist-lib/questions.mjs",
      "require": "./dist-lib/questions.cjs.js"
    },
    "./style": "./dist-lib/assets/index.css"
  },
  "files": [
    "dist/",
    "dist-lib/"
  ],
  "scripts": {
    "predev": "./scripts/setup-audio.sh",
    "dev": "vite",
    "dev:local": "./scripts/check-local-links.sh && yarn --cwd content/phoneticAnalytics gen:cards && yarn --cwd content/phoneticAnalytics gen:strategies && yarn --cwd content/phoneticAnalytics db:seed && vite",
    "dev:mobile": "./scripts/setup-audio.sh && VITE_COUCH_BASE_URL=$(ip route get 1.1.1.1 | awk '{print $7; exit}'):5984/ vite --host",
    "dev:vostro": "./scripts/remote-dev.sh start && ./scripts/remote-dev.sh up",
    "typecheck:vostro": "./scripts/remote-dev.sh typecheck",
    "build": "npm run build:phonetic-index && npm run build:webapp && npm run build:lib",
    "build:phonetic-index": "tsx scripts/build-phonetic-index.ts",
    "export:letterpeople": "tsx scripts/export-letterpeople/index.ts",
    "export:email-cta": "tsx scripts/export-email-cta.ts",
    "skup": "./scripts/skup.sh",
    "build:webapp": "vite build && tsx scripts/prerender-public.ts && tsx scripts/precompress-dist.ts",
    "build:lib": "BUILD_MODE=library vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "test:e2e": "cypress open",
    "test:e2e:headless": "cypress run",
    "ci:e2e": "vite dev & wait-on http://localhost:6173 && cypress run"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@mdi/font": "^7.3.67",
    "@vue-skuilder/common": "0.3.6",
    "@vue-skuilder/common-ui": "0.3.6",
    "@vue-skuilder/courseware": "0.3.6",
    "@vue-skuilder/db": "0.3.6",
    "animejs": "4.2.0",
    "events": "^3.3.0",
    "marked": "^15.0.6",
    "pinia": "^2.3.0",
    "qrcode": "^1.5.4",
    "siteswap.js": "^0.4.1",
    "three": "^0.186.0",
    "vue": "^3.5.27",
    "vue-router": "^4.2.0",
    "vuetify": "^3.7.0"
  },
  "devDependencies": {
    "@types/cypress": "1.1.6",
    "@types/events": "^3",
    "@types/qrcode": "^1.5.6",
    "@types/subset-font": "^2",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue-skuilder/cli": "0.3.6",
    "cypress": "14.1.0",
    "playwright": "^1.59.1",
    "sharp": "^0.34.5",
    "subset-font": "^2.9.0",
    "svgo": "^4.0.1",
    "terser": "^5.39.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.9",
    "vite-plugin-dts": "^4.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.0.15",
    "vue-tsc": "^3.2.4",
    "wait-on": "8.0.2"
  },
  "stableVersion": "0.1.11",
  "description": "Skuilder course application: letterspractice",
  "packageManager": "yarn@4.6.0"
}
